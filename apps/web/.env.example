# Public URL of the site. Defaults to the placeholder https://umair.example.dev
NEXT_PUBLIC_SITE_URL=

# --- Contact form -----------------------------------------------------------
# Neon Postgres connection string. Without it the form shows a "can't send
# right now" message instead of failing. Run `pnpm db:migrate` once after setting it.
DATABASE_URL=

# Long random string used to hash sender IPs for rate limiting (min 16 chars).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONTACT_IP_SALT=

# Email notifications via Resend. If any of these is missing, messages are
# still saved and email_status is set to "skipped".
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Must be a sender on a domain verified in Resend, e.g. "Portfolio <hello@your-domain.dev>"
CONTACT_FROM_EMAIL=
